[Unit]
Description=movie-picks daily email
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/movie-picks
Environment=METRICS_FILE=/home/user/monitoring/textfile/movie_picks.prom
ExecStart=/usr/bin/python3 -I /home/user/movie-picks/app/movie_picks.py pick
TimeoutStartSec=9h
