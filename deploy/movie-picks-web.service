[Unit]
Description=movie-picks download-link handler
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=user
WorkingDirectory=/home/user/movie-picks
ExecStart=/usr/bin/python3 -I /home/user/movie-picks/app/movie_picks.py serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
